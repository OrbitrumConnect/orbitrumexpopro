{
  "name": "orbitrum-connect",
  "version": "1.0.0",
  "description": "Orbitrum Connect — rede profissional relacional (Vercel + Supabase)",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npx tsx watch index.ts",
