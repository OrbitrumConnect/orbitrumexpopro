{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["backend/shared/*"]
    }
  },
  "include": ["api/**/*.ts", "backend/**/*.ts"],
  "exclude": ["node_modules", "client", "frontend"]
}
