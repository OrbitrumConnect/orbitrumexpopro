# ORBITRUM — variáveis de ambiente (referência). NUNCA commitar o .env real com valores.
# Segredos vão SÓ no painel do Vercel/Supabase, nunca no repositório.

# --- FRONTEND (client, VITE_* — embutidas no build; setar no Vercel) ---
VITE_SUPABASE_URL=https://wuaupjjbfvctelvyyfda.supabase.co
VITE_SUPABASE_ANON_KEY=          # anon key (público, vai no bundle)

# --- BACKEND (se hospedar o Express na Vercel ou local) ---
DATABASE_URL=                    # pooler do Supabase (transaction, :6543) — SEGREDO (tem senha)
SUPABASE_URL=https://wuaupjjbfvctelvyyfda.supabase.co
SUPABASE_ANON_KEY=               # anon key
SESSION_SECRET=                  # string aleatória forte — SEGREDO
NODE_ENV=production
FRONTEND_URL=https://orbitrum.com.br
# PORT=5000                      # só local; na Vercel o handler é exportado (sem listen)

# --- LOGIN GOOGLE: configurado no PAINEL do Supabase (Auth > Providers > Google), não aqui ---
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET vão no Supabase (o Client Secret é SEGREDO).

